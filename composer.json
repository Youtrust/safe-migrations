{
    "name": "youtrust/safe-migrations",
    "description": "Make your migrations safe",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Benoit Galati",
            "email": "benoit.galati@youtrust.com"
        },
        {
            "name": "Nicolas Dousson",
            "email": "nicolas.dousson@youtrust.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Youtrust\\SafeMigrations\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Youtrust\\SafeMigrations\\Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "require": {
        "php": "^8.3",
        "doctrine/dbal": "^3.7|^4.0",
        "doctrine/migrations": "^3.6",
        "symfony/string": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.9",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^10.4.2|^11.0",
        "symfony/var-dumper": ">=6.3.8|^7.0|^8.0"
    }
}
